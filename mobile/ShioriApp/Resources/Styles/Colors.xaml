<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
  Paleta do Shiori (a mesma do site, src/index.css, tema escuro).
  Para mudar o visual do app inteiro, troque as cores do bloco "Shiori" abaixo.
  O bloco "Nomes do template" só reaproveita a paleta nos estilos padrão do MAUI (Styles.xaml).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Shiori -->
    <Color x:Key="Bg">#0c0a1d</Color>
    <Color x:Key="Panel">#1a1538</Color>
    <Color x:Key="Ink">#f5f1ff</Color>
    <Color x:Key="Muted">#a59fca</Color>
    <Color x:Key="Line">#2e2660</Color>
    <Color x:Key="Pink">#cbb2ff</Color>
    <Color x:Key="Cyan">#3de2ff</Color>
    <Color x:Key="Yellow">#ffe14d</Color>
    <Color x:Key="OnPink">#1a1240</Color>
    <Color x:Key="Danger">#ff6b6b</Color>

    <!-- Cores dos status da lista (iguais às do site) -->
    <Color x:Key="StatusWatching">#3de2ff</Color>
    <Color x:Key="StatusPlanning">#ffe14d</Color>
    <Color x:Key="StatusCompleted">#7cff8a</Color>
    <Color x:Key="StatusPaused">#b98cff</Color>
    <Color x:Key="StatusDropped">#ff6b6b</Color>

    <!-- Nomes do template (usados em Styles.xaml) -->
    <Color x:Key="Primary">#cbb2ff</Color>
    <Color x:Key="PrimaryDark">#cbb2ff</Color>
    <Color x:Key="PrimaryDarkText">#1a1240</Color>
    <Color x:Key="Secondary">#3de2ff</Color>
    <Color x:Key="SecondaryDarkText">#1a1240</Color>
    <Color x:Key="Tertiary">#ffe14d</Color>
    <Color x:Key="White">#f5f1ff</Color>
    <Color x:Key="Black">#0c0a1d</Color>
    <Color x:Key="Magenta">#cbb2ff</Color>
    <Color x:Key="MidnightBlue">#1a1538</Color>
    <Color x:Key="OffBlack">#0c0a1d</Color>
    <Color x:Key="Gray100">#f5f1ff</Color>
    <Color x:Key="Gray200">#d9d3f2</Color>
    <Color x:Key="Gray300">#a59fca</Color>
    <Color x:Key="Gray400">#a59fca</Color>
    <Color x:Key="Gray500">#a59fca</Color>
    <Color x:Key="Gray600">#a59fca</Color>
    <Color x:Key="Gray900">#2e2660</Color>
    <Color x:Key="Gray950">#1a1538</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
