<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:ani="clr-namespace:Shiori.Core.AniList;assembly=Shiori.Core"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.DetailPage"
             x:DataType="vm:DetailViewModel"
             x:Name="Page"
             Title="{Binding Summary.DisplayTitle}"
             BackgroundColor="{StaticResource Bg}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="0,0,0,32">

                <!-- Banner + capa -->
                <Grid HeightRequest="230">
                    <Image Source="{Binding Detail.Banner}" Aspect="AspectFill" Opacity="0.55" HeightRequest="160" VerticalOptions="Start" />
                    <BoxView VerticalOptions="Start" HeightRequest="160">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.3" />
                                <GradientStop Color="{StaticResource Bg}" Offset="1" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14" Padding="16,0" VerticalOptions="End">
                        <Border StrokeThickness="2" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" HeightRequest="160">
                            <Image Source="{Binding Summary.Cover}" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="4">
                            <Label Text="{Binding Summary.DisplayTitle}" Style="{StaticResource Display}" FontSize="20" />
                            <Label Text="{Binding Summary.TitleNative}" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                            <Label Text="{Binding Summary.AverageScore, StringFormat='★ {0}%'}" TextColor="{StaticResource Yellow}" FontAttributes="Bold"
                                   IsVisible="{Binding Summary.AverageScore, Converter={StaticResource HasValue}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <controls:ErrorView />

                <!-- Próximo episódio -->
                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource Panel}" Margin="16,0" HorizontalOptions="Start" IsVisible="{Binding HasNextEpisode}">
                    <Label Text="{Binding NextEpisodeText, StringFormat='⏰ {0}'}" TextColor="{StaticResource Cyan}" FontSize="13" />
                </Border>

                <!-- Minha lista -->
                <Border Style="{StaticResource Card}" Margin="16,0" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="NA MINHA LISTA" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsSaving}" IsVisible="{Binding IsSaving}" Color="{StaticResource Pink}" HeightRequest="20" />
                        </Grid>
                        <Label Text="Escolha um status para adicionar:" Style="{StaticResource Muted}" IsVisible="{Binding NotInList}" />

                        <FlexLayout BindableLayout.ItemsSource="{Binding StatusChoices}" Wrap="Wrap" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusChoice">
                                    <Button Text="{Binding Label}" Margin="0,0,8,8" CornerRadius="999" Padding="14,6" FontSize="13"
                                            BackgroundColor="{StaticResource Line}" TextColor="{StaticResource Ink}" BorderColor="{Binding Color}" BorderWidth="0"
                                            Command="{Binding SetStatusCommand, Source={x:Reference Page}, x:DataType=vm:DetailViewModel}" CommandParameter="{Binding Status}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding Selected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{Binding Color}" />
                                                <Setter Property="TextColor" Value="{StaticResource OnPink}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <VerticalStackLayout IsVisible="{Binding InList}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding ProgressText}" TextColor="{StaticResource Ink}" VerticalOptions="Center" FontAttributes="Bold" />
                                <Button Grid.Column="1" Text="−1" Style="{StaticResource Square}" Command="{Binding DecrementCommand}" />
                                <Button Grid.Column="2" Text="+1" Style="{StaticResource Square}" Command="{Binding IncrementCommand}" BackgroundColor="{StaticResource Pink}" TextColor="{StaticResource OnPink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding ScoreText}" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="−" Style="{StaticResource Square}" Command="{Binding ScoreDownCommand}" />
                                <Button Grid.Column="2" Text="+" Style="{StaticResource Square}" Command="{Binding ScoreUpCommand}" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="{Binding FavoriteText}" Style="{StaticResource Ghost}" Command="{Binding ToggleFavoriteCommand}" />
                                <Button Text="Remover" Style="{StaticResource Ghost}" TextColor="{StaticResource Danger}" Command="{Binding RemoveCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Gêneros -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Summary.Genres}" Wrap="Wrap" Margin="16,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                <Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource Ink}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Sinopse -->
                <VerticalStackLayout Margin="16,0" Spacing="6">
                    <Label Text="Sinopse" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Detail.Description}" TextColor="{StaticResource Ink}" LineHeight="1.3" />
                    <Label Text="{Binding Studios, StringFormat='Estúdio: {0}'}" Style="{StaticResource Muted}"
                           IsVisible="{Binding Studios, Converter={StaticResource HasValue}}" />
                </VerticalStackLayout>

                <!-- Personagens -->
                <Label Text="Personagens" Style="{StaticResource SectionTitle}" Margin="16,4,16,0" />
                <CollectionView ItemsSource="{Binding Detail.Characters}" HeightRequest="150" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header><BoxView WidthRequest="6" Color="Transparent" /></CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ani:CharacterSummary">
                            <VerticalStackLayout WidthRequest="90" Spacing="4">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCharacterCommand, Source={x:Reference Page}, x:DataType=vm:DetailViewModel}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="110" BackgroundColor="{StaticResource Panel}">
                                    <Image Source="{Binding Image}" Aspect="AspectFill" />
                                </Border>
                                <Label Text="{Binding Name}" FontSize="11" MaxLines="2" LineBreakMode="TailTruncation" TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Ver página completa no Shiori" Margin="16,0" Command="{Binding OpenOnSiteCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Pink}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
