<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.CalendarPage"
             x:DataType="vm:CalendarViewModel"
             x:Name="Page"
             Title="Calendário"
             BackgroundColor="{StaticResource Bg}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Próximos 7 dias, no seu horário" Style="{StaticResource Muted}" VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="Só os meus" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                <Switch IsToggled="{Binding OnlyMine}" OnColor="{StaticResource Pink}" ThumbColor="{StaticResource Ink}" />
            </HorizontalStackLayout>
        </Grid>
        <controls:ErrorView Grid.Row="1" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsLoading}" RefreshColor="{StaticResource Pink}">
            <CollectionView ItemsSource="{Binding Days}" IsGrouped="True" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Nada passando nesses dias. Desligue &quot;Só os meus&quot; para ver tudo." Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:AiringGroup">
                        <Label Text="{Binding Label}" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiringRow">
                        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Page}, x:DataType=vm:CalendarViewModel}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Mine}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Cyan}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="56,44,*" ColumnSpacing="12">
                                <Label Text="{Binding Time}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Cyan}" VerticalOptions="Center" />
                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 6" HeightRequest="62">
                                    <Image Source="{Binding Item.Media.Cover}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Item.Media.DisplayTitle}" TextColor="{StaticResource Ink}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding EpisodeText}" Style="{StaticResource Muted}" FontSize="12" />
                                        <Label Text="● na sua lista" TextColor="{StaticResource Cyan}" FontSize="12" IsVisible="{Binding Mine}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
