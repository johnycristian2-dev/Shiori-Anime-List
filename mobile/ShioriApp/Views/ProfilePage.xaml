<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Perfil"
             BackgroundColor="{StaticResource Bg}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsLoading}" RefreshColor="{StaticResource Pink}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

                <controls:ErrorView />

                <!-- Avatar e nome -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 48" Stroke="{StaticResource Pink}" StrokeThickness="3"
                            BackgroundColor="{StaticResource Panel}" HorizontalOptions="Center">
                        <Grid>
                            <Label Text="栞" FontSize="40" TextColor="{StaticResource Pink}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image Source="{Binding Avatar}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding Name}" Style="{StaticResource Display}" HorizontalOptions="Center" />
                    <Label Text="{Binding Handle}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Números da lista -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="MINHA LISTA" Style="{StaticResource Caption}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Stats}" Wrap="Wrap" JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatItem">
                                    <VerticalStackLayout WidthRequest="96" Margin="0,0,0,8">
                                        <Label Text="{Binding Value}" FontSize="24" FontAttributes="Bold" TextColor="{Binding Color}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Ações -->
                <Button Text="Ver perfil completo" Command="{Binding OpenFullProfileCommand}" IsVisible="{Binding HasProfile}" />
                <Button Text="Editar perfil" Command="{Binding EditProfileCommand}" IsVisible="{Binding HasProfile}"
                        BackgroundColor="{StaticResource Line}" TextColor="{StaticResource Ink}" />
                <VerticalStackLayout IsVisible="{Binding NoProfile}" Spacing="8">
                    <Label Text="Você ainda não tem um perfil público. Crie para aparecer para seus amigos." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <Button Text="Criar perfil" Command="{Binding CreateProfileCommand}" />
                </VerticalStackLayout>
                <Button Text="Sair da conta" Style="{StaticResource Ghost}" TextColor="{StaticResource Danger}" Command="{Binding SignOutCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
