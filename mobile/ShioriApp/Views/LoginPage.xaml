<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             x:Class="ShioriApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">
    <ScrollView>
        <VerticalStackLayout Padding="28,64,28,28" Spacing="16" MaximumWidthRequest="420">

            <Label Text="栞" FontSize="64" HorizontalOptions="Center" TextColor="{StaticResource Pink}" />
            <Label Text="SHIORI" Style="{StaticResource Display}" FontSize="32" HorizontalOptions="Center" />
            <Label Text="Entre com a mesma conta do site." TextColor="{StaticResource Muted}" HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="E-MAIL" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="voce@exemplo.com" ReturnType="Next" AutomationId="Email" />
                    <Label Text="SENHA" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Password}" IsPassword="True" Placeholder="••••••••" ReturnType="Go"
                           ReturnCommand="{Binding SignInCommand}" AutomationId="Password" />

                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />

                    <Grid>
                        <Button Text="Entrar" Command="{Binding SignInCommand}" IsVisible="{Binding IsLoading, Converter={StaticResource Not}}" />
                        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Pink}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Button Text="Criar conta" Style="{StaticResource Ghost}" Command="{Binding CreateAccountCommand}" />
                <Button Text="Esqueci a senha" Style="{StaticResource Ghost}" Command="{Binding ForgotPasswordCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
