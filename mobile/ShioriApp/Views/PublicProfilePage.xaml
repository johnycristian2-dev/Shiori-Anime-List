<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:list="clr-namespace:Shiori.Core.List;assembly=Shiori.Core"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.PublicProfilePage"
             x:DataType="vm:PublicProfileViewModel"
             x:Name="Page"
             Title="{Binding Data.Profile.Name}"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <!-- Carrossel de capas (favoritos, vendo agora, melhores) -->
        <DataTemplate x:Key="CoverItem" x:DataType="list:ListEntryView">
            <VerticalStackLayout WidthRequest="100" Spacing="4">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Page}, x:DataType=vm:PublicProfileViewModel}" CommandParameter="{Binding .}" />
                </VerticalStackLayout.GestureRecognizers>
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="140" BackgroundColor="{StaticResource Panel}">
                    <Image Source="{Binding Cover}" Aspect="AspectFill" />
                </Border>
                <Label Text="{Binding Title}" FontSize="11" MaxLines="2" LineBreakMode="TailTruncation" TextColor="{StaticResource Ink}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="0,16,0,32" Spacing="14">
                <controls:ErrorView />
                <Label Text="Perfil não encontrado ou privado." Style="{StaticResource Muted}" HorizontalOptions="Center" IsVisible="{Binding NotFound}" />

                <VerticalStackLayout IsVisible="{Binding Found}" Spacing="14">
                    <!-- Cabeçalho -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 48" Stroke="{StaticResource Pink}" StrokeThickness="3"
                                BackgroundColor="{StaticResource Panel}" HorizontalOptions="Center">
                            <Grid>
                                <Label Text="栞" FontSize="40" TextColor="{StaticResource Pink}" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding Data.Profile.AvatarUrl}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding Data.Profile.Name}" Style="{StaticResource Display}" HorizontalOptions="Center" />
                        <Label Text="{Binding Data.Profile.Username, StringFormat='@{0}'}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                        <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource Pink}" HorizontalOptions="Center"
                                IsVisible="{Binding Data.Rank, Converter={StaticResource HasValue}}">
                            <Label Text="{Binding Data.Rank}" TextColor="{StaticResource OnPink}" FontAttributes="Bold" FontSize="12" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Números -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="16,0">
                        <FlexLayout BindableLayout.ItemsSource="{Binding Stats}" JustifyContent="SpaceAround" Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatItem">
                                    <VerticalStackLayout WidthRequest="80">
                                        <Label Text="{Binding Value}" FontSize="22" FontAttributes="Bold" TextColor="{Binding Color}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                    <Label Text="{Binding Data.MeanScore, StringFormat='Nota média: {0:0.0}'}" Style="{StaticResource Muted}" HorizontalOptions="Center" />

                    <Label Text="♥ Favoritos" Style="{StaticResource SectionTitle}" Margin="16,8,16,0" />
                    <CollectionView ItemsSource="{Binding Data.Favorites}" ItemTemplate="{StaticResource CoverItem}" HeightRequest="190" SelectionMode="None">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.Header><BoxView WidthRequest="6" Color="Transparent" /></CollectionView.Header>
                        <CollectionView.EmptyView><Label Text="Nenhum favorito ainda." Style="{StaticResource Muted}" Margin="16,0" /></CollectionView.EmptyView>
                    </CollectionView>

                    <Label Text="Vendo agora" Style="{StaticResource SectionTitle}" Margin="16,8,16,0" />
                    <CollectionView ItemsSource="{Binding Data.Watching}" ItemTemplate="{StaticResource CoverItem}" HeightRequest="190" SelectionMode="None">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.Header><BoxView WidthRequest="6" Color="Transparent" /></CollectionView.Header>
                        <CollectionView.EmptyView><Label Text="Nada no momento." Style="{StaticResource Muted}" Margin="16,0" /></CollectionView.EmptyView>
                    </CollectionView>

                    <Label Text="Melhores completos" Style="{StaticResource SectionTitle}" Margin="16,8,16,0" />
                    <CollectionView ItemsSource="{Binding Data.TopCompleted}" ItemTemplate="{StaticResource CoverItem}" HeightRequest="190" SelectionMode="None">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.Header><BoxView WidthRequest="6" Color="Transparent" /></CollectionView.Header>
                    </CollectionView>

                    <Button Text="Conquistas, seguir e comentários (no site)" Margin="16,8,16,0" Command="{Binding OpenOnSiteCommand}"
                            BackgroundColor="{StaticResource Line}" TextColor="{StaticResource Ink}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Pink}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
