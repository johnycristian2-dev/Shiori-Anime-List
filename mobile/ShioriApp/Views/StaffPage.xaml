<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:ani="clr-namespace:Shiori.Core.AniList;assembly=Shiori.Core"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.StaffPage"
             x:DataType="vm:StaffViewModel"
             x:Name="Page"
             Title="{Binding Staff.Name}"
             BackgroundColor="{StaticResource Bg}">
    <Grid>
        <CollectionView ItemsSource="{Binding Roles}" SelectionMode="None" Margin="16,0"
                        RemainingItemsThreshold="4" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="0,16,0,8">
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="14">
                        <Border StrokeThickness="2" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 14" HeightRequest="170" BackgroundColor="{StaticResource Panel}">
                            <Image Source="{Binding Staff.Image}" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End">
                            <Label Text="{Binding Staff.Name}" Style="{StaticResource Display}" FontSize="22" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Info}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InfoItem">
                                        <Label FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Label, StringFormat='{0}: '}" TextColor="{StaticResource Muted}" />
                                                    <Span Text="{Binding Value}" TextColor="{StaticResource Ink}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <controls:ErrorView />
                    <Label Text="{Binding Staff.Description}" TextColor="{StaticResource Ink}" LineHeight="1.3" MaxLines="8" LineBreakMode="TailTruncation"
                           IsVisible="{Binding Staff.Description, Converter={StaticResource HasValue}}" />
                    <Label Text="Personagens" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=3, Default=6}" VerticalItemSpacing="12" HorizontalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ani:StaffRole">
                    <VerticalStackLayout Spacing="4">
                        <!-- Foto do personagem (abre o personagem) com a capa do anime no canto (abre o anime) -->
                        <Grid HeightRequest="150">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Panel}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCharacterCommand, Source={x:Reference Page}, x:DataType=vm:StaffViewModel}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding Character.Image}" Aspect="AspectFill" />
                            </Border>
                            <Border StrokeThickness="2" Stroke="{StaticResource Bg}" StrokeShape="RoundRectangle 6" WidthRequest="40" HeightRequest="56"
                                    HorizontalOptions="End" VerticalOptions="End" Margin="4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenMediaCommand, Source={x:Reference Page}, x:DataType=vm:StaffViewModel}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Image Source="{Binding Media.Cover}" Aspect="AspectFill" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Character.Name}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Ink}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Media.DisplayTitle}" FontSize="11" TextColor="{StaticResource Muted}" MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Pink}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
