<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:ani="clr-namespace:Shiori.Core.AniList;assembly=Shiori.Core"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             x:Name="Page"
             Title="Buscar"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,8,16,0" RowSpacing="10">
        <Border Style="{StaticResource Card}" Padding="12,2">
            <SearchBar Text="{Binding Query}" Placeholder="Buscar anime ou mangá…" TextColor="{StaticResource Ink}"
                       PlaceholderColor="{StaticResource Muted}" CancelButtonColor="{StaticResource Muted}" BackgroundColor="Transparent" />
        </Border>

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Anime" Command="{Binding SetTypeCommand}" CommandParameter="ANIME" CornerRadius="999" Padding="16,6">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAnime}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource Line}" />
                        <Setter Property="TextColor" Value="{StaticResource Ink}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Mangá" Command="{Binding SetTypeCommand}" CommandParameter="MANGA" CornerRadius="999" Padding="16,6">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsManga}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource Line}" />
                        <Setter Property="TextColor" Value="{StaticResource Ink}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="{StaticResource Pink}" HeightRequest="24" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="2">
            <controls:ErrorView />
            <Label Text="Nada encontrado. Tente outro nome (em inglês ou japonês também funciona)."
                   IsVisible="{Binding IsEmpty}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,24" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=3, Default=6}" VerticalItemSpacing="14" HorizontalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Digite pelo menos 2 letras para buscar." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ani:MediaSummary">
                    <controls:MediaCard>
                        <controls:MediaCard.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMediaCommand, Source={x:Reference Page}, x:DataType=vm:SearchViewModel}" CommandParameter="{Binding Id}" />
                        </controls:MediaCard.GestureRecognizers>
                    </controls:MediaCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
