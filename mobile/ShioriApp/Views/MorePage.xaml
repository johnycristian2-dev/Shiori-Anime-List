<?xml version="1.0" encoding="utf-8" ?>
<!-- Aba "Mais": todas as funções do site que abrem na parte web. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:web="clr-namespace:Shiori.Core.Web;assembly=Shiori.Core"
             x:Class="ShioriApp.Views.MorePage"
             x:DataType="vm:MoreViewModel"
             Title="Mais"
             BackgroundColor="{StaticResource Bg}">
    <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None" Margin="16,0">
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="vm:SectionGroup">
                <Label Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="web:SiteSection">
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}, Path=OpenCommand, x:DataType=vm:MoreViewModel}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Glyph}" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource Muted}" />
                            <Label Text="NATIVO" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Cyan}" CharacterSpacing="1" IsVisible="{Binding IsNative}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
