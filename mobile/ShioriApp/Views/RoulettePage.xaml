<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShioriApp.ViewModels"
             xmlns:controls="clr-namespace:ShioriApp.Views.Controls"
             x:Class="ShioriApp.Views.RoulettePage"
             x:DataType="vm:RouletteViewModel"
             Title="Roleta"
             BackgroundColor="{StaticResource Bg}">
    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="18" MaximumWidthRequest="460">
            <Label Text="🎲" FontSize="48" HorizontalOptions="Center" x:Name="Dice" />
            <Label Text="Não sabe o que ver?" Style="{StaticResource Display}" HorizontalOptions="Center" />
            <Label Text="{Binding PlanningCount, StringFormat='A roleta sorteia um dos {0} títulos da sua lista Quero ver.'}"
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            <controls:ErrorView />

            <!-- Resultado -->
            <Border x:Name="Result" Style="{StaticResource Card}" Padding="14" IsVisible="{Binding HasPick}">
                <Grid ColumnDefinitions="100,*" ColumnSpacing="14">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="140">
                        <Image Source="{Binding Pick.Cover}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding Pick.Title}" Style="{StaticResource Display}" FontSize="18" />
                        <Label Text="{Binding Pick.Total, StringFormat='{0} episódios'}" Style="{StaticResource Muted}"
                               IsVisible="{Binding Pick.Total, Converter={StaticResource HasValue}}" />
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSpinning, Converter={StaticResource Not}}">
                            <Button Text="Vou assistir!" Command="{Binding StartWatchingCommand}" FontSize="13" Padding="12,6" />
                            <Button Text="Detalhes" Command="{Binding OpenCommand}" Style="{StaticResource Ghost}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Sua lista Quero ver está vazia. Use a Busca, o Explorar ou o Swipe para adicionar títulos."
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding PlanningCount}" Value="0">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Label.Triggers>
                <Label.IsVisible>False</Label.IsVisible>
            </Label>

            <Button Text="Girar a roleta" Command="{Binding SpinCommand}" FontSize="18" HeightRequest="56" CornerRadius="28" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
