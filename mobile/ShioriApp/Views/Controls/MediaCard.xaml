<?xml version="1.0" encoding="utf-8" ?>
<!-- Cartão de anime/mangá: capa + título. Usado no Início e na Busca. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ani="clr-namespace:Shiori.Core.AniList;assembly=Shiori.Core"
             x:Class="ShioriApp.Views.Controls.MediaCard"
             x:DataType="ani:MediaSummary">
    <VerticalStackLayout Spacing="6" WidthRequest="{OnIdiom Phone=120, Default=140}">
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Panel}"
                HeightRequest="{OnIdiom Phone=170, Default=200}">
            <Grid>
                <Image Source="{Binding Cover}" Aspect="AspectFill" />
                <Border Style="{StaticResource Chip}" BackgroundColor="#CC0c0a1d" Padding="6,2"
                        HorizontalOptions="End" VerticalOptions="Start" Margin="6"
                        IsVisible="{Binding AverageScore, Converter={StaticResource HasValue}}">
                    <Label Text="{Binding AverageScore, StringFormat='★ {0}%'}" FontSize="11" TextColor="{StaticResource Yellow}" FontAttributes="Bold" />
                </Border>
            </Grid>
        </Border>
        <Label Text="{Binding DisplayTitle}" MaxLines="2" LineBreakMode="TailTruncation" FontSize="13" TextColor="{StaticResource Ink}" />
    </VerticalStackLayout>
</ContentView>
