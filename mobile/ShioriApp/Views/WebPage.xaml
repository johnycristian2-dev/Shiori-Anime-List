<?xml version="1.0" encoding="utf-8" ?>
<!-- Parte web: o site publicado, já logado com a mesma conta do app. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShioriApp.Views.WebPage"
             BackgroundColor="{StaticResource Bg}">
    <Grid>
        <WebView x:Name="Web" />
        <Grid x:Name="Loading" BackgroundColor="{StaticResource Bg}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Pink}" />
                <Label Text="Abrindo o Shiori…" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        <VerticalStackLayout x:Name="ErrorBox" IsVisible="False" VerticalOptions="Center" Padding="24" Spacing="12" BackgroundColor="{StaticResource Bg}">
            <Label x:Name="ErrorText" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
            <Button Text="Tentar de novo" Clicked="OnRetry" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
