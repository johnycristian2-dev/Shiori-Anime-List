# Opcional: habilita "Conectar com AniList" (sincronização direta).
# Crie um client em https://anilist.co/settings/developer
# Redirect URL = endereço do seu site (ex.: https://shiori.vercel.app/)
VITE_ANILIST_CLIENT_ID=

# Opcional: conta Shiori + sincronização entre aparelhos (Supabase)
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Mostra o botão "Continuar com Google" (ative o provedor Google no Supabase antes)
VITE_GOOGLE_AUTH=
