{
  "manifest_version": 3,
  "name": "Shiori Watch Party",
  "short_name": "Shiori",
  "version": "0.2.0",
  "description": "Sua lista do Shiori se atualiza sozinha enquanto você assiste no Crunchyroll, e a watch party sincroniza play, pause e chat com os amigos.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Shiori Watch Party",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": {
    "service_worker": "bg.js",
    "scripts": ["bg.js"]
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.crunchyroll.com/*", "https://graphql.anilist.co/*", "__SUPABASE_HOST__/*"],
  "content_scripts": [
    {
      "matches": ["https://*.crunchyroll.com/*"],
      "js": ["crunchy.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://shiori-anime-list.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["site.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "watchparty@shiori-anime-list", "strict_min_version": "128.0" }
  }
}
